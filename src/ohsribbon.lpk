<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="ohsribbon"/>
    <Type Value="RunTime"/>
    <Description Value="A ribbon component for Fresnel."/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="model"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Files Count="3">
      <Item1>
        <Filename Value="model\ohsribbon.model.sizing.pas"/>
        <UnitName Value="ohsribbon.model.sizing"/>
      </Item1>
      <Item2>
        <Filename Value="model\ohsribbon.model.keytips.pas"/>
        <UnitName Value="ohsribbon.model.keytips"/>
      </Item2>
      <Item3>
        <Filename Value="ohsribbon.ui.ribbon.pas"/>
        <UnitName Value="ohsribbon.ui.ribbon"/>
      </Item3>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="Fresnel"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
